# ===== Core =====
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ===== Auth =====
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ===== MongoDB =====
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/ai_interview?retryWrites=true&w=majority

# ===== Queue driver =====
# Selects how the API enqueues processing jobs:
#   bullmq → Upstash Redis + long-running BullMQ worker  (dev default)
#   sqs    → AWS SQS + Lambda                            (prod target)
QUEUE_DRIVER=bullmq

# ===== Redis (Upstash) =====
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6380

# ===== SQS — only required when QUEUE_DRIVER=sqs =====
# URL of the processing queue. Get it from the CloudFormation output
# `ProcessingQueueUrl` after deploying infra/template.yaml.
AWS_SQS_QUEUE_URL=
# Optional — if not set, falls back to AWS_REGION, then to the region parsed
# from the queue URL.
AWS_SQS_REGION=

# ===== AWS S3 =====
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=ai-interview-chunks

# ===== AI =====
DEEPGRAM_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ===== Tunables =====
CHUNK_MAX_BYTES=20971520
PRESIGN_TTL_SECONDS=3600
